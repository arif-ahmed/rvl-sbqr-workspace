# =============================================================================
# .env.example — sample template for the workspace-root .env (LOCAL DEV ONLY).
# Copy to `.env` (gitignored via *.env) and fill in real values:
#
#   Copy-Item .env.example .env
#
# This file is safe to commit: placeholders only, never real passwords.
# The workspace `.env` is read by the workspace-level MCP configs
# (.mcp.json / opencode.json -> sbqr-postgres server in
# rvl-sbqr-backend/tools/postgres-mcp). MCP-only keys: no API/JWT/S3
# secrets belong here.
# =============================================================================

# Primary app database (local instance shared with the backend).
ConnectionStrings__sbqr_app=Host=localhost;Port=5432;Database=sbqr_app;Username=postgres;Password=CHANGEME;Include Error Detail=true

# Standalone fallback URL (exposed as "default", and for "sbqr_app" when the
# key above is absent). Keep separate so rotating the app string doesn't
# silently affect the agent surface.
DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5432/sbqr_app

# Write gate: MUST stay false unless the connecting role is a dedicated dev
# role AND the environment name has no prod/stage/release in it (C20).
POSTGRES_MCP_ALLOW_WRITES=false
# pg_query row cap (1..1000, default 100).
POSTGRES_MCP_MAX_ROWS=100
# Per-statement timeout in seconds (1..600, default 30).
POSTGRES_MCP_TIMEOUT_SECONDS=30
# Extra non-local hosts (comma-separated) the server may connect to.
# Default allowlist is localhost / 127.0.0.1 / ::1 only.
POSTGRES_MCP_ALLOWED_HOSTS=
